{
  "name": "gamesir-hid",
  "version": "0.1.0",
  "description": "Controle do GameSir Cyclone 2 via HID (LEDs, perfis, vibração, estado), a partir da engenharia reversa do GameSir Connect",
  "keywords": [
    "gamesir",
    "cyclone-2",
    "gamepad",
    "controller",
    "hid",
    "node-hid",
    "webhid",
    "rgb",
    "macro",
    "reverse-engineering"
  ],
  "license": "MIT",
  "homepage": "https://github.com/pedrosegato/gamesir-reverse-engineering#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrosegato/gamesir-reverse-engineering.git",
    "directory": "lib"
  },
  "bugs": {
    "url": "https://github.com/pedrosegato/gamesir-reverse-engineering/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/transport/node-hid.js",
    "./webhid": "./dist/transport/webhid.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "peerDependencies": {
    "node-hid": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "node-hid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "@types/w3c-web-hid": "^1.0.6",
    "node-hid": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
