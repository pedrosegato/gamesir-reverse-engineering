{
  "name": "gamesir-hid",
  "version": "0.1.0",
  "description": "Controle do GameSir Cyclone 2 via HID (LEDs, perfis, vibração, estado), a partir da engenharia reversa do GameSir Connect",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./node": "./dist/transport/node-hid.js",
    "./webhid": "./dist/transport/webhid.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "example": "tsx"
  },
  "peerDependencies": {
    "node-hid": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "node-hid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.0.0",
    "@types/w3c-web-hid": "^1.0.6",
    "node-hid": "^3.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  },
  "license": "MIT"
}
